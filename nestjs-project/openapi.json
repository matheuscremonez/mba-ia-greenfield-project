      "InitiateVideoUploadDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "My first video",
            "maxLength": 255
          },
          "original_filename": {
            "type": "string",
            "example": "video.mp4",
            "maxLength": 255
          },
          "content_type": {
            "type": "string",
            "enum": [
              "video/mp4",
              "video/webm",
              "video/quicktime"
            ],
            "example": "video/mp4"
          },
          "size_bytes": {
            "type": "number",
            "example": 1048576,
            "minimum": 1,
            "maximum": 10737418240
          }
        },
        "required": [
          "title",
          "original_filename",
          "content_type",
          "size_bytes"
        ]
      },
      "InitiatedUploadDetailsDto": {
        "type": "object",
        "properties": {
          "upload_id": {
            "type": "string"
          },
          "part_size_bytes": {
            "type": "number",
            "example": 67108864
          },
          "part_count": {
            "type": "number",
            "example": 1
          },
          "expires_in_seconds": {
            "type": "number",
            "example": 900
          }
        },
        "required": [
          "upload_id",
          "part_size_bytes",
          "part_count",
          "expires_in_seconds"
        ]
      },
      "InitiatedVideoUploadResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "DRAFT"
            ]
          },
          "upload": {
            "$ref": "#/components/schemas/InitiatedUploadDetailsDto"
          }
        },
        "required": [
          "id",
          "status",
          "upload"
        ]
      },
      "SignUploadPartsDto": {
        "type": "object",
        "properties": {
          "part_numbers": {
            "minItems": 1,
            "maxItems": 20,
            "uniqueItems": true,
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        },
        "required": [
          "part_numbers"
        ]
      },
      "SignedUploadPartDto": {
        "type": "object",
        "properties": {
          "part_number": {
            "type": "number"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "part_number",
          "url",
          "expires_at"
        ]
      },
      "SignedUploadPartsResponseDto": {
        "type": "object",
        "properties": {
          "parts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SignedUploadPartDto"
            }
          }
        },
        "required": [
          "parts"
        ]
      },
      "CompleteUploadPartDto": {
        "type": "object",
        "properties": {
          "part_number": {
            "type": "number",
            "minimum": 1
          },
          "etag": {
            "type": "string"
          }
        },
        "required": [
          "part_number",
          "etag"
        ]
      },
      "CompleteVideoUploadDto": {
        "type": "object",
        "properties": {
          "parts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CompleteUploadPartDto"
            }
          }
        },
        "required": [
          "parts"
        ]

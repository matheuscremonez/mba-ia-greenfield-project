      "VideoMetadataDto": {
        "type": "object",
        "properties": {
          "format_name": {
            "type": "string"
          },
          "bit_rate": {
            "type": "number",
            "nullable": true
          },
          "video_codec": {
            "type": "string"
          },
          "audio_codec": {
            "type": "string",
            "nullable": true
          },
          "width": {
            "type": "number"
          },
          "height": {
            "type": "number"
          },
          "frame_rate": {
            "type": "string"
          }
        },
        "required": [
          "format_name",
          "bit_rate",
          "video_codec",
          "audio_codec",
          "width",
          "height",
          "frame_rate"
        ]
      },
      "VideoResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "DRAFT",
              "PROCESSING",
              "READY",
              "ERROR"
            ]
          },
          "original_filename": {
            "type": "string"
          },
          "content_type": {
            "type": "string"
          },
          "size_bytes": {
            "type": "number",
            "maximum": 10737418240
          },
          "duration_seconds": {
            "type": "number",
            "nullable": true
          },
          "metadata": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/VideoMetadataDto"
              }
            ]
          },
          "processing_error": {
            "type": "string",
            "nullable": true
          },
          "thumbnail_url": {
            "type": "string",
            "nullable": true
          },
          "stream_url": {
            "type": "string",
            "nullable": true
          },
          "download_url": {
            "type": "string",
            "nullable": true
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "type": "string"
          },
          "uploaded_at": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          },
          "processed_at": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "title",
          "status",
          "original_filename",
          "content_type",
          "size_bytes",
          "duration_seconds",
          "metadata",
          "processing_error",
          "thumbnail_url",
          "stream_url",
          "download_url",
          "created_at",
          "updated_at",
          "uploaded_at",
          "processed_at"
        ]
      },
      "ApiErrorEnvelope": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 401
          },
          "error": {
            "type": "string",
            "example": "INVALID_CREDENTIALS"
          },
          "message": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ],
            "example": "Invalid email or password"
          },
          "code": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "statusCode",
          "error",
          "message"
        ]
      }
    }
  }
